# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Кому можно пользоваться ботом: Telegram user id через запятую.
# Пусто = всем. Узнать свой id можно у @userinfobot.
ALLOWED_USERS=

# Сколько первых треков из плейлиста максимум отдавать за раз
MAX_PLAYLIST_TRACKS=50

# Треки длиннее этого (в минутах) не скачиваем: у ботов лимит файла 50 МБ
MAX_TRACK_MINUTES=30

# Битрейт mp3 (кбит/с)
AUDIO_BITRATE=192

# Сколько загрузок одновременно (на всех пользователей)
MAX_PARALLEL_DOWNLOADS=2

# Путь к cookies.txt (формат Netscape), если YouTube просит «подтвердить, что вы не бот»
COOKIES_FILE=
